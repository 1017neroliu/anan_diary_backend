# ============================================
# Anan Diary — 环境变量配置
# 复制为 .env 并根据实际环境修改
# ============================================

# ---- 运行环境 ----
ENV=development                     # development | production
SERVER_PORT=8080

# ---- 数据库（方式一：完整 DSN）----
# DSN=host=localhost port=5432 user=postgres password=postgres dbname=anan_diary sslmode=disable TimeZone=Asia/Shanghai

# ---- 数据库（方式二：分解变量）----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=anan_diary
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# ---- JWT ----
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRE_HOURS=168               # token 有效期（小时，默认 7 天）

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 上传 ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ---- 日志 ----
LOG_LEVEL=info